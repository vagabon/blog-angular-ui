{
  "name": "blog-angular-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "gen:container": "ng generate component --type=containers",
    "start": "ng serve",
    "tsc": "tsc",
    "link": "npm link @ng-vagabond-lab/ng-dsv --force && ng serve --configuration link",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest --config vitest.config.mjs",
    "test:coverage": "npm run test -- --no-watch --coverage",
    "sonar": "npm run test:coverage && npx sonar-scanner -Dsonar.login=$SONAR_TOKEN -Dsonar.host.url=http://localhost:9000"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/fire": "^20.1.1",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.4",
    "@ngx-translate/core": "^18.0.0",
    "express": "^5.3.0",
    "remixicon": "^4.9.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.2",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@ng-vagabond-lab/ng-dsv": "^1.0.0",
    "@types/express": "^5.0.6",
    "@types/prismjs": "^1.26.6",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "firebase": "^13.1.0",
    "happy-dom": "^21.0.4",
    "katex": "^0.19.1",
    "marked": "^18.1.1",
    "marked-katex-extension": "^5.1.13",
    "ngx-markdown": "^22.1.1",
    "prettier": "^3.9.10",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.2",
    "sass-embedded": "^1.106.1",
    "sonar-scanner": "^3.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
