{
  "name": "blog-angular-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "gen:container": "ng generate component --type=containers",
    "start": "ng serve",
    "tsc": "tsc",
    "link": "npm link @ng-vagabond-lab/ng-dsv --force && ng serve --configuration link",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest --config vitest.config.ts",
    "test:coverage": "npm run test -- --no-watch --coverage",
    "sonar": "npm run test:coverage && npx sonar-scanner -Dsonar.login=$SONAR_TOKEN -Dsonar.host.url=http://localhost:9000"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-server": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@angular/ssr": "^22.1.7",
    "@ngx-translate/core": "^18.0.0",
    "express": "^5.2.1",
    "katex": "^0.18.5",
    "marked": "^18.0.11",
    "marked-katex-extension": "^5.1.12",
    "ngx-markdown": "^22.0.2",
    "prismjs": "^1.30.0",
    "remixicon": "^4.9.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.1",
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler": "^22.1.5",
    "@angular/compiler-cli": "^22.1.5",
    "@ng-vagabond-lab/ng-dsv": "^0.2.49",
    "@types/express": "^5.0.6",
    "@types/prismjs": "^1.26.6",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "happy-dom": "^20.13.2",
    "prettier": "^3.9.6",
    "rxjs": "~7.8.2",
    "sass-embedded": "^1.103.1",
    "sonar-scanner": "^3.1.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
